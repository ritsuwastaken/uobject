{
    "name": "@ritsuwastaken/uobject",
    "version": "1.0.1",
    "description": "read and write native object data in unreal engine 1 and 2 packages: textures, palettes, sounds, static meshes, skeletal meshes, animations",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "keywords": [
        "animation",
        "dxt",
        "javascript",
        "skeletal",
        "texture",
        "typescript",
        "ukx",
        "uobject",
        "upackage",
        "utx"
    ],
    "author": "ritsuwastaken",
    "license": "Unlicense",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test": "npm run build && node --test \"test/**/*.test.ts\"",
        "prepack": "npm run build"
    },
    "dependencies": {
        "@ritsuwastaken/farchive": "^1.0.4",
        "@ritsuwastaken/upackage": "^1.1.1"
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "typescript": "7.0.2"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ritsuwastaken/uobject.git"
    },
    "engines": {
        "node": ">=22"
    }
}
